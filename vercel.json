{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "www/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/login",
      "dest": "server.js",
      "methods": ["POST"]
    },
    {
      "src": "/register",
      "dest": "server.js",
      "methods": ["POST"]
    },
    {
      "src": "/customers|/orders|/sales|/returns|/payments|/export|/stock",
      "dest": "server.js"
    },
    {
      "src": "/(?:.*\\.(?:js|css|png|jpg|jpeg|gif|svg|woff|woff2|eot|ttf|otf|ico|webp|manifest|json))$",
      "dest": "www/$0"
    },
    {
      "src": "/(.*)",
      "dest": "www/index.html"
    }
  ],
  "env": {
    "DATABASE_URL": "TODO_SET_IN_VERCEL_DASHBOARD",
    "CORS_ORIGIN": "TODO_SET_IN_VERCEL_DASHBOARD"
  }
}
